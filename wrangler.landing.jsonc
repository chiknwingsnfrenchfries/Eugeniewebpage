// Cloudflare Workers config for landing1.eugeniedo.com (ads landing page).
// Static site only: no server code. Built by `npm run build:landing` into dist-landing/.
// Cloudflare dashboard (Workers Builds) settings for this project:
//   Build command:  npm run build:landing
//   Deploy command: npx wrangler deploy --config wrangler.landing.jsonc
// The "name" below must match the Worker's name in the Cloudflare dashboard.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eugeniedo-landing1",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist-landing",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Not served on *.workers.dev once the landing1 custom domain is added;
  // leave true until then so the page can be checked.
  "workers_dev": true,
  "preview_urls": true
}
