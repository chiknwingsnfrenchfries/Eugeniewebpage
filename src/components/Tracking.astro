---
// Analytics and tag manager. Order matters:
// 1. Consent defaults (Google Consent Mode) — must come before GTM
// 2. RudderStack, with consent read from the consent banner's cookie
// 3. Google Tag Manager
//
// NO CONSENT BANNER YET. CookieYes is licensed for quiz.eugeniedo.com only, and
// the plan is to move to GetTerms. Until a banner is installed here, nobody can
// change the defaults below, so:
// - analytics + functional: allowed (RudderStack events, GA-style measurement)
// - marketing/ads + performance: denied. Google Ads tags in GTM run in Consent
//   Mode "cookieless" mode: conversions are still pinged and modelled, but no ad
//   cookies are set. Our own gclid capture (stored with the lead) is unaffected.
// When the new banner is added: load its script FIRST (above everything here),
// have it update Google Consent Mode, and point cmpValue() at its cookie.
//
// Bugs from the quiz build that must not come back:
// - load() is called from the SDK tag's onload, never from a separate block
//   below an async tag.
// - With no consent cookie yet, analytics + functional default to allowed and
//   marketing + performance to denied. Testing === 'yes' alone blocks every new visitor.
// - RudderStack v3 takes consent as allowedConsentIds / deniedConsentIds.
//   (The quiz passes a getConsent() function, which the SDK ignores.)
const GTM_ID = 'GTM-T74GLFPF'
---
<script is:inline>
  window.dataLayer = window.dataLayer || []
  function gtag() { window.dataLayer.push(arguments) }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'granted',
    functionality_storage: 'granted',
    personalization_storage: 'denied',
    security_storage: 'granted',
  })
</script>
<script is:inline>
  // Calls made before the SDK loads are queued here and replayed in initRudderStack().
  window.rsQueue = window.rsQueue || []
  window.rs = function () {
    var args = Array.prototype.slice.call(arguments)
    var ra = window.rudderanalytics
    if (window.rsReady && ra && typeof ra[args[0]] === 'function') {
      try { ra[args[0]].apply(ra, args.slice(1)) } catch (e) { console.warn('[RudderStack]', e) }
    } else {
      window.rsQueue.push(args)
    }
  }
  // Reads a category from the consent banner's cookie. Currently the CookieYes
  // format, which is never present on this domain (see note at the top), so the
  // defaults apply. Replace when the GetTerms banner is installed.
  function cmpValue(category) {
    try {
      var m = document.cookie.match(/(?:^|;\s*)cookieyes-consent=([^;]+)/)
      if (!m) return null
      var pair = decodeURIComponent(m[1]).match(new RegExp('(?:^|,)' + category + ':([^,]+)'))
      return pair ? pair[1] : null
    } catch (e) { return null }
  }
  window.consentState = function () {
    var a = cmpValue('analytics'), f = cmpValue('functional')
    return {
      necessary: true,
      analytics: a === null ? true : a === 'yes',
      functional: f === null ? true : f === 'yes',
      marketing: cmpValue('advertisement') === 'yes' || cmpValue('marketing') === 'yes',
      performance: cmpValue('performance') === 'yes',
    }
  }
  function rsConsentOptions() {
    var c = window.consentState(), allowed = [], denied = []
    for (var k in c) (c[k] ? allowed : denied).push(k)
    return { consentManagement: { enabled: true, provider: 'custom', allowedConsentIds: allowed, deniedConsentIds: denied } }
  }
  function initRudderStack() {
    var opts = rsConsentOptions()
    opts.storage = { type: 'cookieStorage' }
    window.rudderanalytics.load('3E2uEolQpd6x1LeTk22VNJK2Otv', 'https://eugeniedosbtny.dataplane.rudderstack.com', opts)
    window.rsReady = true
    window.rs('page')
    var q = window.rsQueue.splice(0)
    for (var i = 0; i < q.length; i++) window.rs.apply(null, q[i])
    // CookieYes event name; update together with cmpValue() for the new banner
    document.addEventListener('cookieyes_consent_update', function () {
      window.rudderanalytics.consent(rsConsentOptions())
    })
  }
  window.rudderanalytics = window.rudderanalytics || []
</script>
<script is:inline async src="https://cdn.rudderlabs.com/v3/modern/rsa.min.js" onload="initRudderStack()"></script>

<script is:inline define:vars={{ GTM_ID }}>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer',GTM_ID)
</script>
