---
// Consent banner, analytics and tag manager. Order matters:
// 1. GetTerms CMP — must be the first <script> on the page. It sets Google
//    Consent Mode defaults per region, shows the banner, and blocks known
//    third-party scripts until their category is accepted (auto=true).
// 2. Google Consent Mode, set by this file (GetTerms does not send Consent Mode
//    signals to Google: Tag Assistant showed "Default consent state has not been
//    set"). Defaults: everything denied; then updated from GetTerms' choice, or
//    its region default (Canada is opt-out → granted until the visitor declines).
// 3. RudderStack
// 4. Google Tag Manager — Google Ads / GA4 tags inside it follow Consent Mode
//    ("advanced" mode: cookieless pings while denied).
//
// RudderStack policy (decided 2026-11-15):
// - Every page view is sent to RudderStack for every visitor, whatever they
//   choose in the banner ("pre-consent" mode, events delivered immediately).
// - Without analytics consent, RudderStack keeps only a session ID: journeys
//   are visible within one visit, not stitched across visits.
// - Once the visitor accepts Analytics in GetTerms, rudderanalytics.consent()
//   switches RudderStack to its normal persistent cookies.
// - Per-destination consent (e.g. marketing destinations) is set in the
//   RudderStack dashboard using the IDs: necessary, functional, analytics, marketing.
//
// Bugs from the quiz build that must not come back:
// - load() is called from the SDK tag's onload, never from a separate block
//   below an async tag.
// - RudderStack v3 takes consent as allowedConsentIds / deniedConsentIds via
//   consent(); a getConsent() load option does not exist and is ignored.
const { lang } = Astro.props
const GETTERMS = `https://gettermscmp.com/cookie-consent`
const GETTERMS_ID = '95e3a714-5733-4d51-b299-82bd065f4a7e'
const gtLang = lang === 'en' ? 'en' : 'fr'
const GTM_ID = 'GTM-T74GLFPF'
---
<!-- GetTerms CMP -->
<link rel="preload" href={`${GETTERMS}/blocker/${GETTERMS_ID}/${gtLang}?auto=true`} as="script" />
<script is:inline type="text/javascript" src={`${GETTERMS}/blocker/${GETTERMS_ID}/${gtLang}?auto=true`}></script>
<script is:inline async type="text/javascript" src={`${GETTERMS}/widget/${GETTERMS_ID}/${gtLang}?auto=true`}></script>
<!-- End GetTerms CMP -->

<script is:inline>
  // ── Google Consent Mode ─────────────────────────────────────────────────────
  window.dataLayer = window.dataLayer || []
  function gtag() { window.dataLayer.push(arguments) }
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 2000, // tags wait up to 2 s for GetTerms before firing
  })
  gtag('set', 'ads_data_redaction', true) // strip ad identifiers while ad_storage is denied

  function googleConsentFrom(c) {
    var g = function (v) { return v ? 'granted' : 'denied' }
    return {
      ad_storage: g(c.marketing),
      ad_user_data: g(c.marketing),
      ad_personalization: g(c.marketing),
      analytics_storage: g(c.analytics),
      functionality_storage: g(c.functional),
      personalization_storage: g(c.functional),
    }
  }

  // Callbacks waiting for the first consent state (e.g. the thank-you page waits
  // before sending its conversion). Released on the first GetTerms report, or
  // after 2 s if GetTerms never answers (blocked, offline…).
  window.consentKnown = false
  var consentWaiters = []
  window.onConsentReady = function (cb) {
    if (window.consentKnown) { cb(); return }
    consentWaiters.push(cb)
  }
  function releaseConsentWaiters() {
    if (window.consentKnown) return
    window.consentKnown = true
    var w = consentWaiters.splice(0)
    for (var i = 0; i < w.length; i++) { try { w[i]() } catch (e) { console.error(e) } }
  }
  setTimeout(releaseConsentWaiters, 2000)

  // window.rs('track', ...) is safe to call at any time: calls made before the
  // SDK has loaded are queued and replayed in initRudderStack().
  window.rsQueue = window.rsQueue || []
  window.rs = function () {
    var args = Array.prototype.slice.call(arguments)
    var ra = window.rudderanalytics
    if (window.rsReady && ra && typeof ra[args[0]] === 'function') {
      try { ra[args[0]].apply(ra, args.slice(1)) } catch (e) { console.warn('[RudderStack]', e) }
    } else {
      window.rsQueue.push(args)
    }
  }

  // Latest GetTerms consent, normalised to lowercase category names:
  // { decided: bool, functional, analytics, marketing, unclassified: bool }
  // Before GetTerms reports anything: undecided, nothing granted.
  window.siteConsent = { decided: false, functional: false, analytics: false, marketing: false, unclassified: false }
  function readGetTerms(detail) {
    if (!detail || !detail.preferences) return
    var p = {}
    for (var k in detail.preferences) p[k.toLowerCase()] = detail.preferences[k] === true
    window.siteConsent = {
      decided: detail.decided === true,
      functional: !!p.functional,
      analytics: !!p.analytics,
      marketing: !!p.marketing,
      unclassified: !!p.unclassified,
    }
  }

  // Hand the visitor's decision to RudderStack. Only when they have actually
  // decided AND accepted Analytics: otherwise RudderStack stays in pre-consent
  // mode (page views still sent, session-only ID, no persistent cookie).
  var rsConsentApplied = false
  function applyRsConsent() {
    var c = window.siteConsent
    if (!window.rsReady || rsConsentApplied || !c.decided || !c.analytics) return
    var allowed = ['necessary'], denied = []
    ;['functional', 'analytics', 'marketing'].forEach(function (k) { (c[k] ? allowed : denied).push(k) })
    window.rudderanalytics.consent({
      consentManagement: { allowedConsentIds: allowed, deniedConsentIds: denied },
      trackConsent: true, // records the decision as a "Consent Management Interaction" event
    })
    rsConsentApplied = true
  }

  function onGetTermsConsent(detail) {
    if (!detail || !detail.preferences) return
    readGetTerms(detail)
    gtag('consent', 'update', googleConsentFrom(window.siteConsent))
    applyRsConsent()
    releaseConsentWaiters()
  }
  window.addEventListener('getterms:consent', function (e) { onGetTermsConsent(e.detail) })
  // GetTerms' blocker script loads before this one; if it already knows the
  // visitor's choice, apply it now.
  if (window.GetTermsCMP && window.GetTermsCMP.consent) onGetTermsConsent(window.GetTermsCMP.consent)

  function initRudderStack() {
    if (window.GetTermsCMP && window.GetTermsCMP.consent) readGetTerms(window.GetTermsCMP.consent)
    window.rudderanalytics.load('3E2uEolQpd6x1LeTk22VNJK2Otv', 'https://eugeniedosbtny.dataplane.rudderstack.com', {
      consentManagement: { enabled: true, provider: 'custom' },
      preConsent: {
        enabled: true,
        storage: { strategy: 'session' },
        events: { delivery: 'immediate' },
      },
      storage: { type: 'cookieStorage' },
    })
    window.rsReady = true
    applyRsConsent()
    window.rs('page')
    var q = window.rsQueue.splice(0)
    for (var i = 0; i < q.length; i++) window.rs.apply(null, q[i])
  }
  window.rudderanalytics = window.rudderanalytics || []
</script>
<script is:inline async src="https://cdn.rudderlabs.com/v3/modern/rsa.min.js" onload="initRudderStack()"></script>

<script is:inline define:vars={{ GTM_ID }}>
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f)})(window,document,'script','dataLayer',GTM_ID)
</script>
