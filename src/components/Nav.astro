---
import { translations, useLang } from '../lib/i18n.js'
import { SHOW_REVIEWS } from '../lib/flags.js'
import { href, ROUTES } from '../lib/routes.js'

const { lang, current } = Astro.props
const t = useLang(lang)
const nav = translations.nav
const menu = translations.resourcesMenu
const QUIZ_URL = 'https://quiz.eugeniedo.com'
const resourcesActive = current === 'resources' || current.startsWith('guide-') || current === 'home-valuation'
const otherLang = lang === 'fr' ? 'en' : 'fr'
const langHref = ROUTES[current][otherLang]
const h = (k) => href(k, lang)
---
<nav class="nav" id="site-nav">
  <div class="nav-inner">
    <a class="nav-logo" href={h('home')}>
      <img src="/assets/eugenie-logo.png" alt="Eugenie Do" class="nav-logo-img" />
    </a>

    <ul class="nav-links">
      <li><a class:list={['nav-link', { active: current === 'about' }]} href={h('about')}>{t(nav.about)}</a></li>
      {SHOW_REVIEWS && <li><a class:list={['nav-link', { active: current === 'reviews' }]} href={h('reviews')}>{t(nav.reviews)}</a></li>}
      <li><a class:list={['nav-link', { active: current === 'blog' }]} href={h('blog')}>{t(nav.blog)}</a></li>
      <li class="nav-dropdown-wrap" id="nav-dd-wrap">
        <button class:list={['nav-link', 'nav-dropdown-trigger', { active: resourcesActive }]} id="nav-dd-trigger" aria-expanded="false" aria-controls="nav-dd">
          {t(nav.resources)}
          <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
        </button>
        <div class="nav-dropdown" id="nav-dd" hidden>
          <a href={h('guide-island')}>{t(menu.islandGuide)}</a>
          <a href={h('guide-north')}>{t(menu.northGuide)}</a>
          <a href={h('guide-south')}>{t(menu.southGuide)}</a>
          <a class="nav-dropdown-highlight" href={QUIZ_URL} target="_blank" rel="noopener">{t(menu.quiz)} ↗</a>
          <a href={h('guide-buyer')}>{t(menu.buyerGuide)}</a>
        </div>
      </li>
      <li><a class="nav-cta" href={h('contact')}>{t(nav.contact)}</a></li>
    </ul>

    <div class="nav-right">
      <a class="lang-toggle" href={langHref} hreflang={otherLang} aria-label={lang === 'fr' ? 'English version' : 'Version française'}>
        {lang === 'fr' ? 'EN' : 'FR'}
      </a>
    </div>

    <button class="hamburger" id="nav-burger" aria-label="Menu" aria-expanded="false" aria-controls="nav-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div class="mobile-drawer" id="nav-drawer" hidden>
  <a href={h('about')}>{t(nav.about)}</a>
  {SHOW_REVIEWS && <a href={h('reviews')}>{t(nav.reviews)}</a>}
  <a href={h('blog')}>{t(nav.blog)}</a>
  <button class="mob-dropdown-trigger" id="nav-mob-dd-trigger" aria-expanded="false" aria-controls="nav-mob-dd">
    {t(nav.resources)}
    <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6" /></svg>
  </button>
  <div class="mob-dropdown" id="nav-mob-dd" hidden>
    <a href={h('guide-island')}>{t(menu.islandGuide)}</a>
    <a href={h('guide-north')}>{t(menu.northGuide)}</a>
    <a href={h('guide-south')}>{t(menu.southGuide)}</a>
    <a class="mob-dropdown-highlight" href={QUIZ_URL} target="_blank" rel="noopener">{t(menu.quiz)} ↗</a>
    <a href={h('guide-buyer')}>{t(menu.buyerGuide)}</a>
  </div>
  <a class="mob-cta" href={h('contact')}>{t(nav.contact)}</a>
  <a class="mob-lang" href={langHref} hreflang={otherLang}>
    {lang === 'fr' ? '🇨🇦 English' : '🇫🇷 Français'}
  </a>
</div>

<script>
  const nav = document.getElementById('site-nav')
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 20)
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()

  // Desktop "Client Resources" dropdown: hover or click opens, leaving or clicking outside closes
  const wrap = document.getElementById('nav-dd-wrap')
  const trigger = document.getElementById('nav-dd-trigger')
  const dd = document.getElementById('nav-dd')
  const setDd = (open) => {
    dd.hidden = !open
    trigger.classList.toggle('open', open)
    trigger.setAttribute('aria-expanded', String(open))
  }
  trigger.addEventListener('click', () => setDd(dd.hidden))
  trigger.addEventListener('mouseenter', () => setDd(true))
  dd.addEventListener('mouseleave', () => setDd(false))
  document.addEventListener('mousedown', (e) => { if (!wrap.contains(e.target)) setDd(false) })
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setDd(false) })

  // Mobile drawer
  const burger = document.getElementById('nav-burger')
  const drawer = document.getElementById('nav-drawer')
  burger.addEventListener('click', () => {
    const open = drawer.hidden
    drawer.hidden = !open
    burger.classList.toggle('open', open)
    burger.setAttribute('aria-expanded', String(open))
  })
  const mobTrigger = document.getElementById('nav-mob-dd-trigger')
  const mobDd = document.getElementById('nav-mob-dd')
  mobTrigger.addEventListener('click', () => {
    const open = mobDd.hidden
    mobDd.hidden = !open
    mobTrigger.querySelector('.chevron').classList.toggle('open', open)
    mobTrigger.setAttribute('aria-expanded', String(open))
  })
</script>
