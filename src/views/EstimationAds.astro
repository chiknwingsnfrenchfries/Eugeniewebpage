---
// Ads-only landing page: /fr/estimation-gratuite/ (noindex).
// Design: handover-estimation-eugeniedo/mockup/Main.dc.html (2026-11-18).
import { href } from '../lib/routes.js'
import { ads, PHONE_TEL, SHOW_MARKET_ITEMS } from '../lib/estimation-ads-copy.js'
import { trust, GOOGLE_REVIEWS_URL, quoteMarks } from '../lib/trust-copy.js'

const f = ads.form
const L = 'fr'
const [qOpen, qClose] = quoteMarks(L)
const receiveItems = ads.receive.items.filter((i) => SHOW_MARKET_ITEMS || !i.market)
const msgs = { required: f.required, invalidEmail: f.invalidEmail, invalidPhone: f.invalidPhone, sending: f.sending, submit: f.submit }
const privacyHref = href('privacy', 'fr')
const STAR = 'M12 2l3 6.9 7.5.7-5.7 5 1.7 7.4L12 18.1 5.5 22l1.7-7.4-5.7-5 7.5-.7z'
const CHECK = 'M20 6L9 17l-5-5'
---
<div class="ads-top">
  <section class="ads-hero ads-wrap">
    <p class="ads-eyebrow">{ads.eyebrow}</p>
    <h1 class="ads-h1">{ads.h1}<br /><em>{ads.h1Em}</em></h1>

    <div class="ads-broker">
      <img class="ads-broker-photo" src="/assets/eugenie-headshot-160.webp" alt="Eugenie Do" width="64" height="64" fetchpriority="high" />
      <div class="ads-broker-text">
        <span class="ads-broker-name">Eugenie Do</span>
        <span class="ads-muted">{trust.brokerLine[L]}</span>
        <span class="ads-rating">
          <span class="ads-stars" role="img" aria-label={trust.starsLabel[L]}>
            {[0, 1, 2, 3, 4].map(() => <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={STAR} /></svg>)}
          </span>
          {trust.ratingShort[L]}
        </span>
      </div>
    </div>
  </section>

  <section id="estimation" class="ads-form-wrap ads-wrap" aria-labelledby="ads-form-title">
    <form class="ads-card ads-form" id="ads-form" novalidate data-form-id="estimation-ads" data-lang="fr" data-msgs={JSON.stringify(msgs)}>
      <h2 class="ads-form-title" id="ads-form-title">{f.title}</h2>

      <div class="ads-row ads-row-unit">
        <div class="ads-field" data-field>
          <label for="af-address">{f.address}</label>
          <input id="af-address" name="property_address" type="text" required autocomplete="street-address" placeholder={f.addressPlaceholder} />
          <p class="ads-err" id="af-address-err" data-err hidden></p>
        </div>
        <div class="ads-field" data-field>
          <label for="af-unit">{f.unit} <span class="ads-opt">{f.unitOpt}</span></label>
          <input id="af-unit" name="property_unit" type="text" autocomplete="address-line2" placeholder="#" />
        </div>
      </div>
      <div class="ads-row">
        <div class="ads-field" data-field>
          <label for="af-first">{f.firstName}</label>
          <input id="af-first" name="first_name" type="text" required autocomplete="given-name" />
          <p class="ads-err" id="af-first-err" data-err hidden></p>
        </div>
        <div class="ads-field" data-field>
          <label for="af-last">{f.lastName}</label>
          <input id="af-last" name="last_name" type="text" required autocomplete="family-name" />
          <p class="ads-err" id="af-last-err" data-err hidden></p>
        </div>
      </div>
      <div class="ads-field" data-field>
        <label for="af-email">{f.email}</label>
        <input id="af-email" name="email" type="email" required autocomplete="email" inputmode="email" />
        <p class="ads-err" id="af-email-err" data-err hidden></p>
      </div>
      <div class="ads-field" data-field>
        <label for="af-phone">{f.phone} <span class="ads-opt">{f.phoneOpt}</span></label>
        <input id="af-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        <p class="ads-err" id="af-phone-err" data-err hidden></p>
      </div>

      {/* Honeypot: invisible to people and screen readers; bots fill it → nothing is saved */}
      <div class="ads-hp" aria-hidden="true">
        <label for="af-website">Website</label>
        <input id="af-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <label class="ads-check">
        <input type="checkbox" name="marketing_consent" />
        <span>{f.consent}</span>
      </label>

      <p class="ads-form-error" role="alert" data-form-error hidden>{f.error}</p>

      <button type="submit" class="ads-btn">{f.submit}</button>

      <ul class="ads-checks">
        {f.checks.map((c) => (
          <li><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHECK} /></svg>{c}</li>
        ))}
      </ul>
      <p class="ads-notice">{f.notice} <a href={privacyHref}>{f.privacy}</a></p>
    </form>
  </section>
</div>

<section class="ads-proof ads-wrap" aria-label="Eugenie en bref">
  {trust.proof.map((p) => (
    <div class="ads-tile">
      <span class:list={['ads-tile-big', { 'ads-tile-long': p.long }]}>{p.big[L]}</span>
      <span class="ads-tile-small">{p.small[L]}</span>
    </div>
  ))}
</section>

<section class="ads-section">
  <div class="ads-wrap">
    <p class="ads-eyebrow">{ads.receive.eyebrow}</p>
    <h2 class="ads-h2">{ads.receive.title}</h2>
    <ol class="ads-list">
      {receiveItems.map((i, n) => (
        <li><span class="ads-list-num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>{i.text}</li>
      ))}
    </ol>
    <p class="ads-small">{ads.receive.disclaimer}</p>
  </div>
</section>

<section class="ads-section ads-tint">
  <div class="ads-wrap">
    <h2 class="ads-h2">{ads.how.title}</h2>
    <ol class="ads-steps">
      {ads.how.steps.map((s, n) => (
        <li>
          <span class="ads-step-num" aria-hidden="true">{n + 1}</span>
          <div><strong>{s.title}</strong><span>{s.body}</span></div>
        </li>
      ))}
    </ol>
    <a class="ads-btn" href="#estimation">{ads.how.cta}</a>
  </div>
</section>

<section class="ads-section">
  <div class="ads-wrap">
    <p class="ads-eyebrow">{trust.reviews.eyebrow[L]}</p>
    <h2 class="ads-h2">{trust.reviews.title[L]}</h2>
    <p class="ads-rating-line"><span class="ads-stars-text" aria-hidden="true">★★★★★</span>{trust.ratingLong[L]}</p>
    {trust.reviews.items.map((r) => (
      <figure class="ads-review">
        <span class="ads-stars-text" role="img" aria-label={trust.starsLabel[L]}>★★★★★</span>
        <blockquote lang={r.lang}>{qOpen}{r.quote}{qClose}</blockquote>
        <figcaption>{r.caption[L]}</figcaption>
      </figure>
    ))}
    <a class="ads-link" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">{trust.reviews.readAll[L]}</a>
  </div>
</section>

<section class="ads-section ads-tint">
  <div class="ads-wrap ads-about">
    <img class="ads-about-photo" src="/assets/eugenie-portrait-600.webp" alt="Eugenie Do, courtière immobilière résidentielle" width="600" height="800" loading="lazy" decoding="async" />
    <div>
      <p class="ads-eyebrow">{ads.about.eyebrow}</p>
      <h2 class="ads-h2">{ads.about.title}</h2>
      <p class="ads-body">{ads.about.body}</p>
      <ul class="ads-ticks">
        {ads.about.points.map((p) => (
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={CHECK} /></svg>{p}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<section class="ads-section">
  <div class="ads-wrap">
    <h2 class="ads-h2">{ads.faq.title}</h2>
    <div class="ads-faq">
      {ads.faq.items.map((i) => (
        <details>
          <summary>{i.q}</summary>
          <p>{i.a}{i.privacyLink && <> <a href={privacyHref}>{f.privacy}</a></>}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="ads-wrap">
  <div class="ads-closing">
    <h2 class="ads-h2">{ads.closing.title}</h2>
    <p>{ads.closing.body}</p>
    <a class="ads-btn ads-btn-light" href="#estimation">{ads.closing.cta}</a>
    <div class="ads-row">
      <a class="ads-btn-ghost" href={`tel:${PHONE_TEL}`} data-track="closing">{ads.closing.call}</a>
      <a class="ads-btn-ghost" href={`sms:${PHONE_TEL}`} data-track="closing">{ads.closing.text}</a>
    </div>
  </div>
</section>

<div class="ads-sticky" id="ads-sticky" hidden>
  <a class="ads-btn" href="#estimation">{ads.sticky.cta}</a>
  <a class="ads-sticky-call" href={`tel:${PHONE_TEL}`} aria-label={ads.sticky.callLabel} data-track="sticky">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>
  </a>
</div>

<script>
  import { initEstimationForm, trackContactLinks } from '../lib/estimation-form.js'
  import { href } from '../lib/routes.js'

  const form = document.getElementById('ads-form') as HTMLFormElement
  initEstimationForm(form, { redirectTo: href('estimation-ads-thanks', 'fr') })
  trackContactLinks(document)

  // Mobile sticky bar: shown once the visitor has scrolled past the form card,
  // hidden whenever the form is on screen (and on desktop, via CSS).
  const sticky = document.getElementById('ads-sticky') as HTMLElement
  const obs = new IntersectionObserver(([entry]) => {
    const pastForm = !entry.isIntersecting && entry.boundingClientRect.top < 0
    sticky.hidden = !pastForm
  })
  obs.observe(form)
</script>
