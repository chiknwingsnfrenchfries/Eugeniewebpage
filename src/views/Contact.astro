---
import { translations, useLang } from '../lib/i18n.js'

const { lang } = Astro.props
const t = useLang(lang)
const tx = translations.contact
const roleOpts = tx.roleOpts[lang] || tx.roleOpts.en
---
<section class="contact-section">
  <div class="container">
    <p class="section-label">{t(tx.label)}</p>
    <h1 class="section-title contact-title">{t(tx.title)}</h1>
    <p class="contact-sub">{t(tx.sub)}</p>

    <div class="contact-grid">
      <form class="contact-form" id="contact-form" data-lang={lang} data-sending={t(tx.sending)} data-submit={t(tx.submit)}>
        <div class="form-group">
          <label for="cf-role">{t(tx.roleLabel)}</label>
          <select id="cf-role" name="role">
            {roleOpts.map((o, i) => <option value={i === 0 ? '' : o}>{o}</option>)}
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="cf-first">{t(tx.firstName)} *</label>
            <input id="cf-first" name="first_name" type="text" required autocomplete="given-name" placeholder={t(tx.firstName)} />
          </div>
          <div class="form-group">
            <label for="cf-last">{t(tx.lastName)}</label>
            <input id="cf-last" name="last_name" type="text" autocomplete="family-name" placeholder={t(tx.lastName)} />
          </div>
        </div>
        <div class="form-group">
          <label for="cf-email">{t(tx.email)} *</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com" />
        </div>
        <div class="form-group">
          <label for="cf-phone">{t(tx.phone)}</label>
          <input id="cf-phone" name="phone" type="tel" autocomplete="tel" placeholder="(514) 000-0000" />
        </div>
        <div class="form-group">
          <label for="cf-message">{t(tx.message)}</label>
          <textarea id="cf-message" name="message" placeholder={t(tx.msgPlaceholder)}></textarea>
        </div>
        <p class="form-consent">{t(tx.consent)}</p>
        <p class="form-status success" data-status="success" hidden>{t(tx.success)}</p>
        <p class="form-status error" data-status="error" hidden>{t(tx.error)}</p>
        <button type="submit" class="btn-primary submit-btn">{t(tx.submit)}</button>
      </form>

      <div class="contact-info">
            <h3>{t(tx.infoTitle)}</h3>
            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <span>1850 rue Panama, #110<br />Brossard, QC, J4W 3C6</span>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.44 2 2 0 0 1 3.6 1.25h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.18 6.18l1.83-1.83a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <a href="tel:+14384102420">(438) 410-2420</a>
            </div>
            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <a href="mailto:contact@eugeniedo.com">contact@eugeniedo.com</a>
            </div>
            <div class="social-label">{t(tx.findMe)}</div>
            <div class="social-row">
              <a href="#" class="social-btn" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              </a>
              <a href="#" class="social-btn" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="white"/></svg>
              </a>
              <a href="#" class="social-btn" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="white"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href="#" class="social-btn" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="white"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#141210"/></svg>
              </a>
            </div>
          </div>
    </div>
  </div>
</section>

<script>
  import { supabaseInsert } from '../lib/supabase.js'

  const form = document.getElementById('contact-form')
  const btn = form.querySelector('button[type=submit]')
  const show = (s) => form.querySelectorAll('[data-status]').forEach((el) => { el.hidden = el.dataset.status !== s })

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    show(null)
    btn.disabled = true
    btn.textContent = form.dataset.sending
    const v = (name) => form.elements[name].value.trim()
    try {
      await supabaseInsert('leads', {
        role: v('role') || null,
        first_name: v('first_name'),
        last_name: v('last_name') || null,
        email: v('email'),
        phone: v('phone') || null,
        message: v('message') || null,
        source: 'eugeniedo.com-contact',
        lang: form.dataset.lang,
      })
      form.reset()
      show('success')
    } catch (err) {
      console.error(err)
      show('error')
    } finally {
      btn.disabled = false
      btn.textContent = form.dataset.submit
    }
  })
</script>
